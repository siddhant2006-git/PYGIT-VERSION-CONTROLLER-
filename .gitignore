# ==========================================
# PyGit Full-Stack Workspace .gitignore
# ==========================================

# ------------------------------------------
# Environment & Configuration Files
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Python & PyGit Core
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
build/
dist/

# PyGit runtime metadata, atomic temporary files & repos storage
.pygit/
*.tmp
repos/*
!repos/.gitkeep
pygitbackend/repos/*
!pygitbackend/repos/.gitkeep

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# Frontend (pygit-frontend) & Node.js
# ------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ------------------------------------------
# IDE & System Files
# ------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

