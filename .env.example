# ==========================================
# PyGit Environment Configuration Template
# Copy this file to .env and fill in values
# ==========================================

# Backend Configuration (FastAPI)
HOST=0.0.0.0
PORT=8000
REPOS_DIR=repos

# Frontend Configuration (Vite)
# Leave blank in dev to use the Vite proxy (vite.config.js); set it for a
# production build where the frontend isn't served behind a matching proxy.
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to fall back to in-memory mock data when the backend is
# unreachable (offline UI preview). Leave unset/false to let API errors
# surface normally in the UI.
VITE_USE_MOCKS=false
